# Azure Configuration
AZURE_SUBSCRIPTION_ID=975c592b-de9d-451b-b4cd-7c54891882a1
AZURE_RESOURCE_GROUP=pingpong-ai-rg
AZURE_REGION=westeurope

# Storage Account (will be created in STEP 6)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...

# Cosmos DB (will be created in STEP 7)
AZURE_COSMOS_CONNECTION_STRING=AccountEndpoint=https://...;

# SignalR (will be created in STEP 8)
SIGNALR_CONNECTION_STRING=Endpoint=https://...;

# Service Principal (Optional - for automated authentication)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Application Settings
APP_NAME=pingpong-ai-counter
APP_ENV=development
API_PORT=8000
LOG_LEVEL=INFO

# Model Configuration
MODEL_PATH=./models/trained/
YOLO_CONFIDENCE_THRESHOLD=0.5